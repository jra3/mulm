# Whitelist: the build context is only what the Dockerfile COPYs.
# A new file the image needs must be added here, or the build won't see it.
*

!package.json
!package-lock.json
!tsconfig.json
!postcss.config.mjs
!start.sh
!litestream.yml
!src
!public
!db/migrations

# Inside whitelisted directories: local configs and tests.
# The builder makes src/config.json from config.sample.json; start.sh
# overwrites it from the CONFIG_JSON secret at boot.
src/config.json
src/config.production.json
src/config.local.json
src/**/__tests__
src/**/*.test.ts
