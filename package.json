{
	"name": "mulm",
	"version": "1.0.0",
	"description": "a Breeder Awards Program management platform",
	"main": "index.js",
	"engines": {
		"node": ">=24 <25"
	},
	"_moduleAliases": {
		"@": "dist/src"
	},
	"scripts": {
		"dev": "concurrently nodemon \"postcss 'src/**/*.css' 'src/*.css' --base src --dir public --watch\"",
		"build": "tsc && npm run postcss && npm run copy-files",
		"postcss": "postcss 'src/**/*.css' 'src/*.css' --base src --dir public",
		"copy-files": "cp -r ./public ./dist/ && cp -r ./src/views ./dist/src/",
		"test": "NODE_ENV=test tsx --test --test-concurrency 1 src/__tests__/*.test.ts",
		"test:watch": "NODE_ENV=test tsx --test --watch 'src/**/*.test.ts'",
		"test:external": "NODE_ENV=test RUN_EXTERNAL_TESTS=1 tsx --test --test-concurrency 1 'src/__tests__/*-integration.test.ts'",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"start": "node dist/src/index.js",
		"sync-db": "./infrastructure/sync-db-from-production.sh",
		"mcp:species": "tsx src/mcp/species-server.ts",
		"mcp:members": "tsx src/mcp/member-server.ts",
		"mcp:backfill": "tsx src/mcp/backfill-server.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.mcp.json",
		"lint": "eslint 'src/**/*.ts'",
		"lint:fix": "eslint 'src/**/*.ts' --fix",
		"format": "prettier --write \"src/**/*.{ts,js,json}\" \"scripts/**/*.{ts,js}\"",
		"format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"scripts/**/*.{ts,js}\"",
		"script": "tsx",
		"prepare": "husky || true"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jra3/mulm.git"
	},
	"author": "John Allen",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/jra3/mulm/issues"
	},
	"homepage": "https://github.com/jra3/mulm#readme",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1147.0",
		"@aws-sdk/s3-request-presigner": "^3.1147.0",
		"@modelcontextprotocol/sdk": "^1.31.0",
		"@types/multer": "^1.4.13",
		"cookie-parser": "^1.4.7",
		"csv-parse": "^7.0.3",
		"express": "^5.2.1",
		"express-rate-limit": "^8.0.1",
		"helmet": "^8.3.0",
		"jose": "^6.2.12",
		"marked": "^18.1.0",
		"module-alias": "^2.2.3",
		"multer": "^2.0.1",
		"nodemailer": "^10.0.11",
		"pug": "^3.0.3",
		"sharp": "^0.34.3",
		"sqlite": "^5.1.1",
		"sqlite3": "^6.0.1",
		"uuid": "^14.0.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@faker-js/faker": "^10.6.0",
		"@playwright/test": "^1.64.0",
		"@tailwindcss/oxide": "^4.3.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/cookie-parser": "^1.4.10",
		"@types/express-rate-limit": "^5.1.3",
		"@types/module-alias": "^2.0.4",
		"@types/papaparse": "^5.5.2",
		"@types/pug": "^2.0.10",
		"@types/supertest": "^7.2.1",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"autoprefixer": "^10.6.1",
		"concurrently": "^10.0.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lightningcss": "^1.33.0",
		"lint-staged": "^16.4.0",
		"nodemon": "^3.1.14",
		"papaparse": "^5.7.0",
		"playwright": "^1.56.1",
		"postcss": "^8.5.29",
		"postcss-cli": "^12.0.0",
		"prettier": "^3.9.9",
		"supertest": "^7.3.1",
		"tailwindcss": "^4.0.12",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"eslint --fix"
		],
		"scripts/**/*.ts": [
			"eslint --fix"
		]
	},
	"keywords": [],
	"allowScripts": {
		"sqlite3": true,
		"sharp": true,
		"esbuild": true
	}
}
