{
	"compilerOptions": {
		"target": "es2016",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "commonjs",
		"outDir": "./dist",
		"rootDir": ".",
		"resolveJsonModule": true,
		"allowArbitraryExtensions": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"moduleResolution": "bundler",
		"strict": true,
		"sourceMap": false,
		"inlineSourceMap": false,
		"inlineSources": false,

		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"types": ["node"],

		"paths": {
			"@/*": [ "./src/*" ]
		}
	},
	"include": ["**/*", "src/config.json"],
	"exclude": ["infrastructure/cdk.out", "node_modules", "dist", "scripts", "src/__tests__", "**/*.test.ts", "src/mcp"]
}
