include ../mixins/errorMessage.pug

//- The witness panel's Record new species step (#522), swapped into the
//- panel's Species card (#witness-species) in place of what was there. Not a
//- form of its own: it sits inside the panel's form, so Record species and
//- continue posts just this block, and the server answers with the whole
//- panel again, the new Species settled and the Points card prefilled from
//- its Point class and CARES flag. Nothing is created until the Witness is
//- confirmed; Back fetches the page and keeps only the panel.
//-
//- The panel's form has a submit button, so Enter in a text field here would
//- submit the confirm; the keydown guard is the one line of script the step
//- needs.
//-
//- @param submission - the Submission (id, species_type, species_class)
//- @param program - the Submission's Program (`programOfSubmission`), which
//-   the new Species takes: CARES is offered on BAP only
//- @param values - the fields as typed (`recordSpeciesDraftForm`), or the
//-   member's spelling to start from: new_scientific_name, new_common_name,
//-   new_point_class (number or null), new_cares_species
//- @param errors - refusals by field
//- @param correction - whether the step belongs to the correction form (#528),
//-   which carries the flag so the server answers with that form again
//- @param backUrl - the page Back fetches the panel from: the Submission page,
//-   or the correction form
//- @param existing - the Species that already holds the scientific name the
//-   witness typed ({ speciesId, speciesName, commonName }), or null: the
//-   catalogue refuses a second one, so the step offers This one on it
//-   instead, beside the refusal
//-
//- The buttons here name only themselves in hx-disabled-elt: the panel's form
//- names its Confirm button, and a request from inside the form that
//- inherited that would re-enable a button the server rendered disabled.

- const eyebrow = "text-xs font-semibold uppercase tracking-wide text-gray-500"
- const chip = "block text-center py-2 rounded-lg border border-gray-300 bg-white font-semibold text-gray-900 peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 peer-focus-visible:ring-2 peer-focus-visible:ring-amber-400"

- const back = typeof backUrl === "string" ? backUrl : `/submissions/${submission.id}`
- const duplicate = typeof existing === "object" && existing !== null ? existing : null

#witness-record(hx-on:keydown="if (event.key === 'Enter') event.preventDefault()")
	if correction
		input(type="hidden" name="correction" value="1")
	p.mb-1(class=eyebrow) Record new species
	p.text-sm.text-gray-600.mb-3 Only when you're sure it isn't in the catalogue under another name.

	label.block.text-sm.font-semibold(for="witness-new-scientific-name") Scientific name
	input.text-input.w-full.mb-1#witness-new-scientific-name(
		type="text"
		name="new_scientific_name"
		value=values.new_scientific_name || ""
		maxlength="200"
		placeholder="Genus species"
		autocomplete="off"
		required
	)
	+errorMessage('new_scientific_name', 'block mb-2')
	if duplicate
		//- The Species that holds the name, a tap away: the witness panel binds
		//- it and reloads; the correction form asks for itself with it settled
		.flex.items-center.gap-2.border.border-amber-300.bg-amber-50.rounded-lg.px-3.py-2.mb-3#witness-record-existing
			span.flex-1.min-w-0
				span.block.font-semibold.leading-tight= duplicate.commonName || duplicate.speciesName
				if duplicate.commonName
					span.block.italic.text-sm= duplicate.speciesName
			if correction
				button.outline.text-sm.flex-none#witness-record-existing-choose(
					type="button"
					hx-get=`/admin/submissions/${submission.id}/correct-points`
					hx-vals=JSON.stringify({ species_id: duplicate.speciesId })
					hx-target="#witnessPanel"
					hx-swap="outerHTML"
					hx-disabled-elt="this"
				) This one
			else
				button.outline.text-sm.flex-none#witness-record-existing-choose(
					type="button"
					hx-post=`/admin/submissions/${submission.id}/bind-species`
					hx-vals=JSON.stringify({ group_id: duplicate.speciesId })
					hx-disabled-elt="this"
				) This one

	label.block.text-sm.font-semibold.mt-2(for="witness-new-common-name") Common name
	input.text-input.w-full.mb-1#witness-new-common-name(
		type="text"
		name="new_common_name"
		value=values.new_common_name || ""
		maxlength="200"
		placeholder="Optional"
		autocomplete="off"
	)
	+errorMessage('new_common_name', 'block mb-2')

	p.text-sm.text-gray-600.mt-2.mb-3= `${submission.species_type} · ${submission.species_class}`

	p.text-sm.font-semibold.mb-1 Point class
	.grid.grid-cols-4.gap-2
		each option in [5, 10, 15, 20]
			label.cursor-pointer
				input.peer.sr-only(type="radio" name="new_point_class" value=option id=`witness-new-point-class-${option}` checked=option === values.new_point_class)
				span(class=chip)= option
	+errorMessage('new_point_class', 'block mt-1')
	p.text-xs.text-gray-500.mt-1.mb-3 This submission's base points, and every later one's.

	if program === "fish"
		label.flex.items-center.gap-2.mb-3.text-sm.cursor-pointer
			input(type="checkbox" name="new_cares_species" value="on" checked=values.new_cares_species)
			span CARES species

	button.primary.w-full.min-h-12.text-base#witness-record-continue(
		type="button"
		hx-post=`/admin/submissions/${submission.id}/record-species`
		hx-include="#witness-record"
		hx-target="#witness-species"
		hx-swap="innerHTML"
		hx-disabled-elt="this"
	) Record species and continue
	button.outline.w-full.mt-2(
		type="button"
		hx-get=back
		hx-select="#witnessPanel"
		hx-target="#witnessPanel"
		hx-swap="outerHTML"
		hx-disabled-elt="this"
	) Back
