//- The witness panel: a committee member witnesses a Submission and sets its
//- points (ADR-0003). Phone first, one scroll, a sticky total at the bottom.
//-
//- The witness settles the Species, which sets the base points, then the
//- bonuses; the sticky bar sums them on the server and confirms. The panel
//- never says "bind": the member says what it is, and the witness answers
//- whether that is right. When the catalogue has nothing for what the member
//- wrote, the witness records the Species on the panel (#522); it is created
//- by the confirm, in the Witness's transaction, so leaving creates nothing.
//-
//- @param submission - the Submission (id, program, species_type,
//-   species_class, species_common_name, species_latin_name, member_name,
//-   reproduction_date formatted, article_link)
//- @param speciesFacts - the bound Species (`boundSpeciesFacts` in
//-   src/routes/submission.ts), or null when unbound: speciesId, speciesName,
//-   commonName, speciesType, programClass, program, pointClass, isFirstTime,
//-   priorBreedCount, isCaresSpecies. Confirming gives the Submission the
//-   Species' Program, so the bonuses offered are that Program's, not the
//-   one the member filed under.
//- @param speciesChosenByWitness - whether the committee, not the member,
//-   chose the bound Species, so there is no "is that right?" left to ask
//- @param originalWitness - { name, date formatted } when migration 066 reset
//-   the Witness (#524): who saw the fry under the old flow, read off the
//-   reset note, so the re-witnesser asks for no fresh sighting. Null otherwise.
//- @param suggestions - the catalogue's closest Species to what the member
//-   wrote (`SpeciesSuggestionFacts[]`): speciesId, commonName, speciesName,
//-   speciesType, programClass, pointClass. Offered under "Did they mean one
//-   of these?" wherever the search is.
//- @param newSpecies - the Species the witness is recording
//-   (`NewSpeciesFacts`), or null: scientificName, commonName, speciesType,
//-   programClass, program, pointClass, isCaresSpecies. Shown settled and
//-   carried to the confirm in hidden fields; the Points card prefills from it.
//- @param classificationMismatch - whether the Submission's Species type or
//-   Program class disagrees with the Species'. Confirming records the
//-   Species' values on the Submission, so it is said here, not refused.
//- @param spellingAgreement - { commonName, latinName }: "empty", "name",
//-   "scientific-name" or "not-a-name" for each of the member's spellings,
//-   when bound. Only a spelling that is not a Name is offered as one to add;
//-   the common one is offered ticked, the Latin one unticked.
//- @param summary - the sticky bar's initial state (`witnessSummary`)
//- @param allowed - the moves this viewer may make
//- @param changesRequested - whether the committee has changes outstanding:
//-   the ball is with the member, so the panel offers nothing

- const shortNames = { fish: "BAP", plant: "HAP", coral: "CAP" }
- const programShort = shortNames[submission.program] || submission.program
- const recording = Boolean(newSpecies)
- const bound = Boolean(speciesFacts)
//- The Program the Submission will have once confirmed: the settled Species'
- const settledProgram = recording ? newSpecies.program : bound ? speciesFacts.program : submission.program
- const isBap = settledProgram === "fish"
- const isHap = settledProgram === "plant"
- const programMoves = bound && !recording ? speciesFacts.program !== submission.program : false
- const settled = recording || (bound ? Boolean(speciesChosenByWitness) : false)
- const prefilledPoints = recording ? newSpecies.pointClass : bound ? speciesFacts.pointClass : null
- const prefilledCares = recording ? newSpecies.isCaresSpecies : bound ? speciesFacts.isCaresSpecies : false
- const caresNote = recording ? "Not yet in the catalogue" : bound ? (speciesFacts.isCaresSpecies ? "Listed in the catalogue" : "Not listed in the catalogue") : ""
- const prefilledArticle = submission.article_link ? 5 : 0
- const offerCommon = spellingAgreement ? spellingAgreement.commonName === "not-a-name" : false
- const offerLatin = spellingAgreement ? spellingAgreement.latinName === "not-a-name" : false
- const eyebrow = "text-xs font-semibold uppercase tracking-wide text-gray-500"
- const segment = "block text-center py-3 rounded-lg border border-gray-300 bg-white font-semibold text-lg text-gray-900 peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 peer-focus-visible:ring-2 peer-focus-visible:ring-amber-400"
- const chip = "block text-center px-3 py-2 rounded-lg border border-gray-300 bg-white text-sm font-semibold text-gray-900 peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 peer-focus-visible:ring-2 peer-focus-visible:ring-amber-400"
- const track = "relative inline-block w-12 h-7 rounded-full bg-gray-300 transition-colors flex-none after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-6 after:h-6 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:bg-green-600 peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-amber-400"
//- The Points card is gated until the Species is settled: by the witness
//- having chosen or recorded it, or by Yes below (CSS reads the radio; the
//- server reads the posted species_settled and species_id either way).
- const gate = settled ? "" : bound ? "opacity-40 pointer-events-none group-has-[#witness-species-yes:checked]:opacity-100 group-has-[#witness-species-yes:checked]:pointer-events-auto" : "opacity-40 pointer-events-none"

//- A bonus switch: a checkbox styled as a toggle, the label on the left.
mixin witnessSwitch(name, label, amount, note, checked)
	label.flex.items-center.gap-3.min-h-12.cursor-pointer.py-1
		span.flex-1.min-w-0
			span= label
			|
			span.text-gray-500= amount
			if note
				span.block.text-xs.text-gray-500= note
		input.peer.sr-only(type="checkbox" name=name value="on" checked=checked)
		span(class=track aria-hidden="true")

//- The catalogue's closest Species to what the member wrote, each one a tap away
mixin witnessSuggestions()
	if suggestions && suggestions.length
		p.text-sm.font-semibold.mt-3.mb-2 Did they mean one of these?
		each sp in suggestions
			.flex.items-center.gap-2.border.border-gray-300.rounded-lg.px-3.py-2.mb-2(id=`witness-suggestion-${sp.speciesId}`)
				span.flex-1.min-w-0
					span.block.font-semibold.leading-tight= sp.commonName || sp.speciesName
					if sp.commonName
						span.block.italic.text-sm= sp.speciesName
					span.block.text-xs.text-gray-500
						| #{sp.speciesType} · #{sp.programClass}
						if sp.pointClass
							|  · Point class #{sp.pointClass}
						else
							|  · no Point class yet
				button.outline.text-sm.flex-none(
					type="button"
					hx-post=`/admin/submissions/${submission.id}/bind-species`
					hx-vals=JSON.stringify({ group_id: sp.speciesId })
					hx-disabled-elt="this"
				) This one

.status-panel.status-panel-admin#witnessPanel
	.mx-auto.max-w-lg.flex.flex-col.gap-3
		h3.text-white.text-lg.font-semibold.px-1 Witness this submission

		//- Header: who, what Program, when; the form, photos and video are above
		.bg-white.rounded-lg.px-4.py-3#witness-header
			.text-xs.text-gray-500= `${programShort} submission · reproduced ${submission.reproduction_date}`
			.font-semibold.text-gray-900= submission.member_name
			if originalWitness
				//- Reset by migration 066: the fry were seen; only the Species and points are wanted
				p.text-sm.text-gray-700.mt-1#witness-original-witness
					| Originally witnessed by #{originalWitness.name} on #{originalWitness.date}. No fresh sighting is needed: confirm the species and set the points.
			a.text-sm.text-blue-700.underline(href="#species-details") See the full form, photos and video

		if changesRequested
			.bg-white.rounded-lg.p-4.text-gray-900#witness-waiting-on-member
				p.font-semibold Waiting on the member
				p.text-sm.text-gray-600 Changes were requested. The Witness can be confirmed once the member resubmits.
		else
			form.group.flex.flex-col.gap-3#witness-form(
				hx-post=`/admin/submissions/${submission.id}/confirm-witness`
				hx-disabled-elt="#witness-confirm"
			)
				if bound && !recording
					input(type="hidden" name="species_id" value=speciesFacts.speciesId)
				if settled && !recording
					input(type="hidden" name="species_settled" value="1")

				//- Species: sets the base points
				.bg-white.rounded-lg.p-4.text-gray-900#witness-species
					p.mb-1(class=eyebrow) Species · sets the base points
					if recording
						//- Settled on a Species the confirm will create. Its details
						//- ride here, in the card, so recording another or choosing
						//- one from the catalogue drops them with the card.
						#witness-recording
							p.text-sm.text-gray-600 You're recording a new species
							p.font-semibold.text-lg.leading-tight#witness-bound-common= newSpecies.commonName || newSpecies.scientificName
							p.italic#witness-bound-species= newSpecies.scientificName
							p.text-sm.text-gray-600#witness-bound-class
								| #{newSpecies.speciesType} · #{newSpecies.programClass} · Point class #{newSpecies.pointClass}
								if newSpecies.isCaresSpecies
									|  · CARES
							p.text-xs.text-gray-500.mt-1 Member wrote: #{submission.species_common_name} · #{submission.species_latin_name}
							input(type="hidden" name="new_scientific_name" value=newSpecies.scientificName)
							if newSpecies.commonName
								input(type="hidden" name="new_common_name" value=newSpecies.commonName)
							input(type="hidden" name="new_point_class" value=newSpecies.pointClass)
							if newSpecies.isCaresSpecies
								input(type="hidden" name="new_cares_species" value="on")
							input(type="hidden" name="species_settled" value="1")
							//- Not posted: it only reveals the search below
							input.peer.sr-only(type="checkbox" id="witness-species-no")
					else if bound
						if settled
							p.text-sm.text-gray-600 You chose
						else
							p.text-sm.text-gray-600 The member says it's
						p.font-semibold.text-lg.leading-tight#witness-bound-common= speciesFacts.commonName || speciesFacts.speciesName
						p.italic#witness-bound-species= speciesFacts.speciesName
						p.text-sm.text-gray-600#witness-bound-class
							| #{speciesFacts.speciesType} · #{speciesFacts.programClass}
							if speciesFacts.pointClass
								|  · Point class #{speciesFacts.pointClass}
							else
								|  · no Point class yet
						if settled
							p.text-xs.text-gray-500.mt-1 Member wrote: #{submission.species_common_name} · #{submission.species_latin_name}
							//- Not posted: it only reveals the search below
							input.peer.sr-only(type="checkbox" id="witness-species-no")
						if classificationMismatch
							.bg-amber-50.border.border-amber-300.rounded.p-2.mt-2.text-sm#witness-mismatch(role="note")
								| The submission says #{submission.species_type} · #{submission.species_class}. Confirming records it as #{speciesFacts.speciesType} · #{speciesFacts.programClass}
								if programMoves
									|  and moves it to #{shortNames[speciesFacts.program] || speciesFacts.program}
								| .
						if !settled
							p.font-semibold.mt-3.mb-2 Is that right?
							.grid.grid-cols-2.gap-2
								label.cursor-pointer
									input.peer.sr-only(type="radio" name="species_settled" value="1" id="witness-species-yes")
									span(class=chip) Yes
								label.cursor-pointer
									input.peer.sr-only(type="radio" name="species_settled" value="0" id="witness-species-no")
									span(class=chip) No
					else
						p.text-sm.text-gray-600 The member wrote
						p.font-semibold.text-lg.leading-tight= submission.species_common_name
						p.italic= submission.species_latin_name
						p.text-sm.text-gray-600= `${submission.species_type} · ${submission.species_class}`

					//- Choosing another Species: shown when unbound, or on No, or
					//- on "Wrong species?". The closest catalogue matches first,
					//- then the search; picking one binds it and reloads the page,
					//- so the panel then shows it as the witness's choice. Last,
					//- recording a Species the catalogue lacks.
					if allowed.bindSpecies
						.mt-3(
							id="witness-species-other"
							class=settled || bound ? "hidden group-has-[#witness-species-no:checked]:block" : ""
						)
							if settled
								p.text-sm.font-semibold.mb-1 Wrong species? Choose another
							else if bound
								p.text-sm.font-semibold.mb-1 Which species is it?
							+witnessSuggestions()
							p.text-sm.text-gray-600.mb-1= suggestions && suggestions.length ? "Or search the catalogue" : "Search the catalogue"
							label.sr-only(for="witness-species-pick") Species
							//- Unfiltered by Species type: a Submission filed under the
							//- wrong type is put right by choosing the right Species.
							select#witness-species-pick.tom-select-typeahead(
								name="group_id"
								data-api-url="/api/species/search"
								data-value-field="group_id"
								data-label-field="text"
								data-search-fields="text,common_name,scientific_name"
								data-min-query-length="2"
								data-max-items="1"
								data-placeholder="Common or scientific name"
							)
							button.outline.w-full.mt-2#witness-species-use(
								type="button"
								hx-post=`/admin/submissions/${submission.id}/bind-species`
								hx-include="#witness-species-pick"
								hx-disabled-elt="this"
							) Use this species
							p.text-sm.text-gray-600.mt-3 Not in the catalogue?
							//- A grey secondary button for now; the colour is a point to iterate on (#522)
							button.outline.w-full.mt-1#witness-species-new(
								type="button"
								hx-get=`/admin/submissions/${submission.id}/record-species`
								hx-target="#witness-species"
								hx-swap="innerHTML"
							) Record new species
					if settled && allowed.bindSpecies
						label.block.mt-3.text-sm.text-blue-700.underline.cursor-pointer(for="witness-species-no" class="group-has-[#witness-species-no:checked]:hidden") Wrong species? Choose another

				//- Points: the base points and every bonus but first-time
				.bg-white.rounded-lg.p-4.text-gray-900#witness-points(class=gate)
					p.mb-2(class=eyebrow) Base points
					.grid.grid-cols-4.gap-2
						each pc in [5, 10, 15, 20]
							label.cursor-pointer
								input.peer.sr-only(type="radio" name="points" value=pc id=`witness-points-${pc}` checked=pc === prefilledPoints)
								span(class=segment)= pc
					if recording
						p.text-xs.text-gray-500.mt-1#witness-point-class= `From the Point class you chose (${newSpecies.pointClass}).`
					else if bound
						if speciesFacts.pointClass
							p.text-xs.text-gray-500.mt-1#witness-point-class= `From the Species' Point class (${speciesFacts.pointClass}).`
						else
							.bg-amber-50.border.border-amber-300.rounded.p-2.mt-2.text-sm#witness-no-point-class The catalogue has no Point class for this Species. The base points you choose become its Point class.

					p.mt-4.mb-1(class=eyebrow) Bonuses
					.divide-y.divide-gray-100
						if isBap
							+witnessSwitch("cares_species", "CARES species", "+5", caresNote, prefilledCares)
						.flex.items-center.gap-3.min-h-12.py-1
							span.flex-1.min-w-0
								span Article
								span.block.text-xs.text-gray-500= submission.article_link ? "The member linked one" : "Only if it is already written"
							.flex.gap-1
								each option in [[0, "None"], [5, "+5"], [10, "+10"]]
									label.cursor-pointer
										input.peer.sr-only(type="radio" name="article_points" value=option[0] id=`witness-article-${option[0]}` checked=option[0] === prefilledArticle)
										span(class=chip)= option[1]
						if isHap
							+witnessSwitch("flowered", "Flowered", "+ base points", "", false)
							+witnessSwitch("sexual_reproduction", "Sexual reproduction", "+ base points", "", false)
					if recording || (bound && speciesFacts.isFirstTime)
						p.text-xs.text-green-700.mt-2#witness-first-time No one has had this species approved yet. A first-time +5 is added at the meeting if this one is approved first.
					else if bound
						p.text-xs.text-gray-500.mt-2#witness-first-time= `Approved ${speciesFacts.priorBreedCount} time${speciesFacts.priorBreedCount === 1 ? "" : "s"} before, so no first-time bonus.`

				//- The member's spelling as a Name, only where it is not one already
				if bound && !recording && (offerCommon || offerLatin)
					.bg-white.rounded-lg.p-4.text-gray-900.text-sm#witness-names
						p.font-semibold.mb-1 Save the member's spelling
						if offerCommon
							label.flex.gap-2.items-start.py-1
								input.mt-1(type="checkbox" name="add_common_name" value="on" checked)
								span
									| "
									span.font-medium= submission.species_common_name
									| " as a common name of this species
						if offerLatin
							label.flex.gap-2.items-start.py-1
								input.mt-1(type="checkbox" name="add_scientific_name" value="on")
								span
									| "
									span.italic= submission.species_latin_name
									| " as a scientific name of this species

				.text-sm#committee-error(role="alert")

				if allowed.requestChanges
					button.destructive.w-full.h-12.text-base(
						type="button"
						hx-get=`/admin/dialog/submissions/${submission.id}/request-changes`
						hx-target="closest body"
						hx-swap="beforeend") Request changes

				//- The sticky bar: the sum is the server's, refreshed on every change
				.sticky.bottom-0.bg-gray-700.rounded-lg.p-3#witness-footer(
					hx-post=`/admin/submissions/${submission.id}/witness-summary`
					hx-trigger="change from:#witness-form"
					hx-include="#witness-form"
					hx-swap="innerHTML"
				)
					include witnessSummary.pug
