include ../mixins/errorMessage.pug

- const hasPointsError = errors && errors.has && errors.has("points");

//- The approval panel: approval is about Points and bonuses only. The
//- Species is the one the witness bound, shown read-only with its Point class,
//- which prefills the Points. An unbound Submission is refused (see `approve`).
//-
//- @param submission - id, points, program and the bonus columns
//- @param approval - the bound Species (`approvalPanelData` in
//-   src/routes/submission.ts), or null when unbound
//- @param errors - validation errors by field
- const pointClass = approval ? approval.pointClass : null
- const prefilledPoints = pointClass
- const plural = approval ? (approval.priorBreedCount > 1 ? "s" : "") : ""

if !approval
    .container.mx-auto.max-w-4xl#approval-unbound
        h3.text-white.text-lg.font-semibold.mb-2 Not bound to a Species
        p.text-white.mb-2 This Submission cannot be approved until it is bound to a Species, and there is no binding at approval: a committee member fixes it by hand.
        .flex.gap-4.items-center.justify-center
            button.destructive(
                type="button"
                hx-get=`/admin/dialog/submissions/${submission.id}/request-changes`
                hx-target="closest body"
                hx-swap="beforeend") Request Changes
            button.destructive(
                type="button"
                hx-delete=`/submissions/${submission.id}`
                hx-confirm="Are you sure you want to permanently delete this submission? This cannot be undone.") Delete
else
    .container.mx-auto.flex.justify-center.space-x-4
        form(hx-post=`/admin/submissions/${submission.id}/approve` id="approval-form")
            input(type="hidden" name="id" value=submission.id)

            .flex.flex-col.gap-3
                // The bound Species, read-only
                .text-white#approval-species
                    p
                        span.font-semibold Species:
                        |  
                        span.italic#approval-species-name= approval.speciesName
                        span.text-sm.text-gray-300= ` (${approval.speciesType}, ${approval.programClass})`
                    p#approval-point-class
                        span.font-semibold Point class:
                        |  
                        if pointClass
                            span= pointClass
                        else
                            span.text-yellow-300 not set for this Species - choose the Points

                // Points, prefilled from the Point class and still the committee's to change
                .flex.gap-4.items-center
                    label.text-white.whitespace-nowrap(for="base-points") Points:
                    .flex.flex-col
                        .select-wrapper.max-w-40
                            select(name="points" id="base-points" class=hasPointsError ? "error" : "")
                                option(value="" disabled selected=prefilledPoints == null) Base Points
                                option(value=5 selected=prefilledPoints == 5) 5
                                option(value=10 selected=prefilledPoints == 10) 10
                                option(value=15 selected=prefilledPoints == 15) 15
                                option(value=20 selected=prefilledPoints == 20) 20
                        +errorMessage('points')

                // Bonuses the bound Species implies
                .flex.gap-4.items-center
                    .flex.gap-2.items-center
                        input(
                            type="checkbox"
                            id="first"
                            name="first_time_species"
                            checked=approval.isFirstTime)
                        label.text-white(for="first") First Time Species
                        if approval.isFirstTime
                            span.text-sm.text-green-400 ✓ First time!
                        else if approval.priorBreedCount
                            span.text-sm.text-gray-400= `Previously bred ${approval.priorBreedCount} time${plural}`

                    if submission.program == "fish"
                        .flex.gap-2.items-center
                            input(
                                type="checkbox"
                                id="cares"
                                name="cares_species"
                                checked=approval.isCaresSpecies)
                            label.text-white(for="cares") CARES Species
                            if approval.isCaresSpecies
                                span.text-sm.text-green-400 (auto-detected)

                +bonusErrors(bonusFields)

                // Action buttons (static, below dynamic section)
                .flex.gap-4.items-center
                    button.primary.p-4(type="submit") Approve
                    button.destructive(
                        type="button"
                        hx-get=`/admin/dialog/submissions/${submission.id}/request-changes`
                        hx-target="closest body"
                        hx-swap="beforeend") Request Changes
                    button.destructive(
                        type="button"
                        hx-delete=`/submissions/${submission.id}`
                        hx-confirm="Are you sure you want to permanently delete this submission? This cannot be undone.") Delete

                // Additional Bonuses (collapsible)
                .flex.gap-4.items-center
                    details
                        summary.link.light.p-4 Additional Bonuses
                        .flex.flex-col.gap-4.mt-2
                            .flex.gap-4
                                .select-wrapper.max-w-50
                                    select(name="article_points")
                                        option(value="" disabled selected) Article Points
                                        option(value=0 selected=submission.article_points == 0) No Article
                                        option(value=5 selected=submission.article_points == 5) 5
                                        option(value=10 selected=submission.article_points == 10) 10

                                input.text-input.w-full(
                                    name="article_url"
                                    type="text"
                                    placeholder="Article / Video Link")

                            if submission.program == "plant"
                                .grid.gap-4.grid-cols-2
                                    .flex.gap-2.items-center
                                        input(
                                            type="checkbox"
                                            id="flowered"
                                            name="flowered"
                                            checked=submission.flowered == 1)
                                        label.text-white(for="flowered") Flowered

                                    .flex.gap-2.items-center
                                        input(
                                            type="checkbox"
                                            id="sexual"
                                            name="sexual_reproduction"
                                            checked=submission.sexual_reproduction == 1)
                                        label.text-white(for="sexual") Sexual Reproduction
