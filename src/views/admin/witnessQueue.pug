include ../header.pug
include adminNav.pug
include ../mixins/date.pug
include ../mixins/caresBadge.pug

doctype html
html
	+headTag(title)

	body.bg-gray-700.text-gray-900
		+pageHeader(true, title, subtitle)

		main.mx-auto.max-w-lg.px-3.py-4.flex.flex-col.gap-3(class="md:max-w-2xl")
			+adminNav("witness", program, counts)

			section#queue-screening.flex.flex-col.gap-2
				h2.text-xs.font-semibold.uppercase.tracking-wide.text-gray-300 Ready to screen
				p.text-sm.text-gray-300.-mt-1 Check the submission, choose its species and points, then confirm the witness. Oldest submissions first.
				if submissions.length === 0
					.bg-white.rounded-lg.p-4.text-center.text-gray-500#queue-screening-empty Nothing left to screen. Check another program or the approval queue.
				each sub in submissions
					details.bg-white.rounded-lg.shadow-sm.overflow-hidden(id=`screening-row-${sub.id}`)
						summary.list-none.cursor-pointer.p-3.flex.gap-3.items-start(class="[&::-webkit-details-marker]:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400")
							.flex-1.min-w-0
								.font-semibold
									| #{sub.member_name}
									| #{' '}
									+programChip(sub.programShort)
								.break-words= sub.species_common_name
								if sub.species_latin_name !== sub.species_common_name
									i.block.text-sm.text-gray-500.break-words= sub.species_latin_name
								.text-xs.text-gray-500.mt-1
									| Submitted #{' '}
									+shortDate(sub.submitted_on, "Submitted on")
							span.text-gray-400(aria-hidden="true") ⌄
						.px-3.pb-3.pt-2.border-t.border-gray-100
							.flex.flex-wrap.items-center.gap-2.text-sm.text-gray-600
								span= sub.species_class
								if sub.is_cares_species == 1
									+caresBadge("sm")
							p.text-sm.text-gray-600.mt-1
								| Reproduced #{' '}
								+shortDate(sub.reproduction_date, "Reproduction date")
							p.text-xs.text-gray-500.mt-2
								a.underline(href=`/member/${sub.member_id}`) Member profile
							if sub.mine
								p.text-sm.text-gray-600.bg-gray-100.rounded.p-3.mt-3 Your own submission. Another committee member screens it.
								a.block.text-center.text-sm.text-blue-700.underline.py-3(href=`/submissions/${sub.id}`) View submission
							else
								a.block.w-full.text-center.py-3.mt-3.rounded-lg.bg-blue-600.text-white.font-semibold(href=`/submissions/${sub.id}` class="hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-amber-400") Review submission
