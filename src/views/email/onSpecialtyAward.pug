doctype html
html
	head
		meta(charset="utf-8")
		title Specialty Award Earned
		style.
			body {
				font-family: Arial, sans-serif;
				line-height: 1.6;
				color: #333;
				max-width: 600px;
				margin: 0 auto;
				padding: 20px;
			}
			.header {
				background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
				color: white;
				padding: 30px 20px;
				text-align: center;
				border-radius: 8px 8px 0 0;
			}
			.trophy {
				font-size: 64px;
				margin: 10px 0;
			}
			.content {
				background-color: #f8fafc;
				padding: 20px;
				border: 1px solid #e2e8f0;
			}
			.award-box {
				background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
				border-left: 4px solid #f59e0b;
				padding: 20px;
				margin: 15px 0;
				border-radius: 6px;
				text-align: center;
			}
			.award-title {
				font-size: 26px;
				font-weight: bold;
				color: #92400e;
				margin: 10px 0;
			}
			.footer {
				background-color: #64748b;
				color: white;
				padding: 15px;
				text-align: center;
				border-radius: 0 0 8px 8px;
				font-size: 12px;
			}
			.button {
				display: inline-block;
				background-color: #f59e0b;
				color: white;
				padding: 12px 24px;
				text-decoration: none;
				border-radius: 5px;
				margin: 10px 0;
				font-weight: bold;
			}
			h1, h2, h3 {
				margin: 0;
			}
	body
		.header
			h1 Brooklyn Aquarium Society
			h3 Specialty Species Program
			.trophy 🏅

		.content
			p Hello #{member.display_name},

			p
				strong You have earned a Specialty Award.

			.award-box
				.award-title= awardName

			p This award recognises breeding the required number of distinct species within its group — a milestone that takes patience and real skill across many separate spawns.

			p
				a.button(href=`https://${domain}/me` style="color: white; text-decoration: none;") View Your Achievements

		.footer
			p
				strong Brooklyn Aquarium Society
			p Educating Aquarists since 1911
			p
				a(href="https://basny.org" style="color: white;") basny.org
