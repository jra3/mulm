doctype html
html
	head
		meta(charset="utf-8")
		title Submission Removed
		style.
			body {
				font-family: Arial, sans-serif;
				line-height: 1.6;
				color: #333;
				max-width: 600px;
				margin: 0 auto;
				padding: 20px;
			}
			.header {
				background: linear-gradient(135deg, #64748b 0%, #475569 100%);
				color: white;
				padding: 30px 20px;
				text-align: center;
				border-radius: 8px 8px 0 0;
			}
			.content {
				background-color: #f8fafc;
				padding: 20px;
				border: 1px solid #e2e8f0;
			}
			.submission-details {
				background-color: white;
				padding: 15px;
				border-radius: 6px;
				border: 1px solid #e2e8f0;
				margin: 15px 0;
			}
			.footer {
				background-color: #64748b;
				color: white;
				padding: 15px;
				text-align: center;
				border-radius: 0 0 8px 8px;
				font-size: 12px;
			}
			h1, h2, h3 {
				margin: 0;
			}
	body
		.header
			h1 Brooklyn Aquarium Society
			h3 Submission Removed

		.content
			p Hello #{member.display_name},

			p A member of the Breeders Award Committee has removed the following submission from the Portal.

			.submission-details
				p
					strong= submission.species_common_name
				if submission.species_latin_name
					p
						em= submission.species_latin_name
				if submission.reproduction_date
					p Spawn date: #{submission.reproduction_date}

			p This is usually because the submission was a duplicate or was filed in error. No points were affected — an approved submission cannot be removed this way.

			p If this was not what you expected, reply to this message or write to #{programContactEmail} and the committee will sort it out.

		.footer
			p
				strong Brooklyn Aquarium Society
			p Educating Aquarists since 1911
			p
				a(href="https://basny.org" style="color: white;") basny.org
