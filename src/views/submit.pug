include header.pug
include mixins/changesRequestedBanner.pug

doctype html
html

    +headTag(title)

    body.bg-white.text-gray-800
        +pageHeader(true, title, subtitle)

        +changesRequestedBanner(changesRequested)

        include bapForm/form.pug

        script.
            function initStaticMultiSelects() {
                document.querySelectorAll("select.tom-select-multi").forEach((select) => {

                    if (select.tomselect) {
                        select.tomselect.destroy();
                    }

                    new TomSelect(select, {
                        hideSelected: true,
                        create: true,
                    });
                });
            }

            function initMemberSelect() {
                const memberSelect = document.getElementById('member_select');
                // Only initialize if element exists and has the tom-select-single class (admin only)
                if (!memberSelect || !memberSelect.classList.contains('tom-select-single')) {
                    return;
                }

                if (memberSelect.tomselect) {
                    memberSelect.tomselect.destroy();
                }

                const instance = new TomSelect(memberSelect, {
                    create: false,
                    maxItems: 1,
                });
                memberSelect.tomSelectInstance = instance;
            }

            function initializeTypeaheads() {
                const typeaheadElements = document.querySelectorAll('select.tom-select-typeahead:not(.tomselected)');
                typeaheadElements.forEach(function(element) {
                    const config = getTypeaheadConfig(element);
                    const tomSelectOptions = buildTomSelectOptions(element, config);
                    const tomSelect = new TomSelect(element, tomSelectOptions);
                    // Store reference for potential cleanup
                    element.tomSelectInstance = tomSelect;
                    // Add class for single-value styling
                    if (config.maxItems === 1) {
                        tomSelect.control.classList.add('single-value');
                    }
                });
            }

            document.addEventListener("htmx:load", function (event) {
                // Only reinitialize Tom Select if the form itself was swapped
                // Don't reinitialize for partial updates like video preview
                const target = event.detail.elt;
                if (target && target.id === 'bapForm') {
                    initStaticMultiSelects();
                    initMemberSelect();
                    initializeTypeaheads();
                }
            });

            // Field linking for the species typeaheads. Picking a known Name
            // binds: it sets the hidden species_id to that Species, fills the
            // Program class (the typeahead only offers Species of the form's
            // Species type) and the other name, and shows the unbind notice.
            // Free text empties species_id. A cleared field changes nothing:
            // a blank spelling still agrees with the Species. Whether a pick
            // binds is the server's call (lifecycle bindingAfterSave).
            function setPickedSpecies(speciesId) {
                const hiddenIdField = document.getElementById('species_id');
                if (hiddenIdField) {
                    hiddenIdField.value = speciesId || '';
                }
                const notice = document.getElementById('species-binding-notice');
                if (notice) {
                    notice.hidden = !speciesId;
                }
            }

            document.addEventListener("typeahead:change", function (e) {
                const target = e.target;
                const detail = e.detail;

                if (target.id !== 'species_common_name' && target.id !== 'species_latin_name') {
                    return;
                }

                const selectedOption = detail.selectedOption;
                if (!detail.value) {
                    return;
                }
                if (!selectedOption || !selectedOption.group_id) {
                    setPickedSpecies(null);
                    return;
                }

                setPickedSpecies(selectedOption.group_id);

                if (selectedOption.program_class) {
                    const speciesClassField = document.getElementById('species_class');
                    if (speciesClassField) {
                        speciesClassField.value = selectedOption.program_class;
                    }
                }

                // Sync the paired field (common <-> scientific)
                const pairedId = target.id === 'species_common_name' ? 'species_latin_name' : 'species_common_name';
                // A Species with no common Name goes by its Latin name, so that
                // fills the common field (#421)
                const pairedValue = target.id === 'species_common_name'
                    ? selectedOption.scientific_name
                    : (selectedOption.common_name || selectedOption.scientific_name);
                const pairedField = document.getElementById(pairedId);
                if (pairedField && pairedField.tomSelectInstance) {
                    const instance = pairedField.tomSelectInstance;
                    // A Species with no Name of the paired kind clears the
                    // paired field: a stale spelling would not agree with it
                    if (!pairedValue) {
                        instance.clear(true);
                        pairedField.value = '';
                        return;
                    }
                    // Options are keyed by the field's own value
                    if (!instance.options[pairedValue]) {
                        instance.addOption({
                            common_name: selectedOption.common_name,
                            scientific_name: selectedOption.scientific_name,
                            group_id: selectedOption.group_id,
                            program_class: selectedOption.program_class
                        });
                    }
                    // Silent, so the paired field does not re-run this handler
                    instance.setValue(pairedValue, true);
                    pairedField.value = pairedValue;
                }
            });

            document.addEventListener("DOMContentLoaded", function () {
                initStaticMultiSelects();
                initMemberSelect();
                initializeTypeaheads();

                document.querySelectorAll("input, textarea, select").forEach((el) => {
                    if (el.name && sessionStorage.getItem(el.name) != undefined) {
                        if (el.type === "checkbox") {
                            el.checked = sessionStorage.getItem(el.name) === "true";
                        } else {
                            el.value = sessionStorage.getItem(el.name);
                        }
                    }
                })
            });
