//- Inline field error message mixin
//- Displays validation errors next to form fields with consistent styling and accessibility
//-
//- @param {string} name - The field name to check for errors
//- @param {string} [customClass=''] - Optional additional CSS classes
//-
//- Example usage:
//-   +errorMessage('email')
//-   +errorMessage('password', 'mt-2')

mixin errorMessage(name, customClass='')
  if errors && errors.has(name)
    span.text-red-600.font-semibold.text-sm(
      role="alert"
      id=`${name}-error`
      aria-live="polite"
      class=customClass
    )= errors.get(name)

//- Bonus validation errors for the approval form (src/points.ts rejects a bonus
//- its Program cannot carry). Such a bonus has no checkbox to sit beside — it is
//- hidden for this Program, or lives in the collapsed Additional Bonuses section —
//- so the messages are shown together beneath the bonus row.
//-
//- @param {string[]} fields - The bonus field names. `src/index.ts` puts
//-   `bonusFields` (src/points.ts) on res.locals, so every render in the app
//-   has it and adding a bonus there shows its errors here without touching
//-   this file. Passed in rather than defaulted, so a caller that has no such
//-   local fails loudly instead of quietly showing no errors at all.
//-
//- Example usage:
//-   +bonusErrors(bonusFields)

mixin bonusErrors(fields)
  .flex.flex-col
    each field in fields
      +errorMessage(field)
