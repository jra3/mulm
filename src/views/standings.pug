include header.pug
include mixins/trophy.pug

doctype html
html
	+headTag(title)

	body.bg-white.text-gray-800
		+pageHeader(isLoggedIn, `Annual Standings for ${year}`)
			span Annual Standings for
			button.annual-year-trigger#annual-year-trigger(type="button" popovertarget="annual-year-menu" aria-controls="annual-year-menu" aria-expanded="false" aria-describedby="annual-year-trigger-help")
				= year
				svg.w-4.h-4(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true")
					path(d="m6 9 6 6 6-6")

		span#annual-year-trigger-help(hidden) Choose a standings year

		nav.annual-year-menu#annual-year-menu(popover="auto" aria-label="Standings year")
			if year > maxYear
				a(href=`/annual/${year}/${program}` aria-current="page")
					= year
					span(aria-hidden="true") ✓
			- for (let choice = maxYear; choice >= minYear; choice--)
				a(href=`/annual/${choice}/${program}` aria-current=choice === year ? "page" : undefined)
					= choice
					if choice === year
						span(aria-hidden="true") ✓

		nav.bg-gray-100.px-4.pt-4(class="sm:hidden" aria-label="Standings program")
			div.grid.rounded-xl.bg-gray-200.p-1(class="gap-0.5 grid-cols-[1fr_1.5fr_1fr]")
				each label, value in { fish: "Breeder", plant: "Horticultural", coral: "Coral" }
					a.flex.items-center.justify-center.min-h-11.rounded-lg.text-sm.text-gray-700(href=`/annual/${year}/${value}` class=program === value ? "bg-white shadow-sm font-semibold" : "hover:bg-gray-100" aria-current=program === value ? "page" : undefined)= label

		section.bg-gray-100.py-4
			div.max-w-4xl.mx-auto.text-center.px-4
				h2(class="text-xl lg:text-4xl font-extrabold mb-4")= title
				if byApproval
					p.text-sm.text-gray-600= `BAP year ${year - 1}–${year} · Approvals September 1–August 31`
					p.text-sm.text-gray-600 Points count when approved at a meeting, regardless of the spawn date.
				else
					p.text-sm.text-gray-600= `BAP year ${year - 1}–${year} · Spawns August 1–July 31`

		section.bg-gray-100.py-4.flex.flex-col.items-center
			div.max-w-2xl
				table.data-table#annualStandings
					thead.contents
						tr.contents
							th Rank
							th Member
							th Points
					tbody.contents
						each member, index in standings
							tr.text-center.max-w-lg.contents
								td= index + 1
								td
									- const name = names[member[0]] ?? ""
									- const memberId = member[0]
									a.link(href=`/member/${memberId}`)= name
									+trophy(trophies[memberId])
								td(class=heading)= member[1]

		.w-full.bg-gray-300.p-4.shadow-md.hidden(class="sm:block")
			.container.mx-auto.flex.justify-center.items-center.space-x-4

				if year > minYear
					a.link(href=`/annual/${year-1}/${program}`)= `← ${year - 1}`

				a(href=`/annual/${year}/fish`)
					button.outline Breeder
				a(href=`/annual/${year}/plant`)
					button.outline Horticultural
				a(href=`/annual/${year}/coral`)
					button.outline Coral

				if year < maxYear
					a.link(href=`/annual/${year+1}/${program}`)= `${year + 1} →`

		script(src="/js/annual-standings.js" defer)
